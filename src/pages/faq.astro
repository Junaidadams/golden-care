---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { faqs } from '../../constants';
import FaqMasterDetail from '../components/FaqMasterDetail.tsx';
import faqHeader from '../assets/faq-header.jpg';
---

<Layout>
	<PageHeader
	image={faqHeader}
		brightness={90}
		imagePosition="top"
		title="Frequently asked questions"
		subtitle="FAQ"
		description="Answers to common questions about my companion visits, services, pricing and subscriptions."
	/>

	<section class="bg-background-2 border-b border-gray-200">
		<div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:px-8">
			<FaqMasterDetail items={faqs} client:load />
		</div>
	</section>

	<section class="bg-brand-600">
		<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl tracking-tight sm:text-4xl font-fraunces font-semibold text-white">
				Still have questions?
			</h2>
			<p class="mt-4 text-lg text-brand-100">
				I'm happy to help with anything else you'd like to know about my services.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow-lg transition hover:bg-brand-50"
			>
				Contact me
			</a>
		</div>
	</section>
</Layout>