---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import HeadingText from '../components/HeadingText.astro';
import Icon from '../components/Icon.tsx';
import { about, philosophy } from '../../constants';
import herBanner from '../assets/her-banner-wr.jpg';
import { Image } from 'astro:assets';
import aboutImage from '../assets/about.jpeg';

---

<Layout
	title="About Me"
	description="Meet the person behind Within Reach — learn about the values, experience and approach behind my personalised assistance services."
>
	<PageHeader
		image={herBanner}
		title={`About Me`}
		subtitle="About Me"
		description="Growing older should not mean becoming less independent — meet the person behind Within Reach."
	/>

	<section class="bg-background-1 border-b border-gray-200">
		<div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
				<div class="flex flex-col gap-6">
					<div class="relative aspect-[4/5] overflow-hidden rounded-sm shadow-sm">
						<Image
							src={aboutImage}
							alt="Caryl Henrico"
							widths={[600, 900, 1280]}
							sizes="(min-width: 1024px) 50vw, 100vw"
							quality="medium"
							loading="eager"
							class="h-full w-full rounded-sm object-cover"
						/>
						<span class="absolute bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-lg bg-black/40 px-4 py-2 text-sm font-bold text-white backdrop-blur">
							{about.name}
						</span>
					</div>
					<blockquote class="border-l-4 border-brand-600 pl-4 leading-relaxed text-gray-800 italic">
						"{about.quote}"
					</blockquote>
				</div>

				<div>
					<HeadingText
						heading={about.name}
						subheading="About"
						description={about.paragraphs[0]}
						position="left"
					/>

					<div class="mt-8 space-y-5">
						{about.paragraphs.slice(1, 5).map((paragraph) => (
							<p class="leading-relaxed text-gray-800">{paragraph}</p>
						))}
						<p class="font-fraunces text-xl font-semibold italic text-brand-700">
							{about.tagline}
						</p>
						{about.paragraphs.slice(5).map((paragraph) => (
							<p class="leading-relaxed text-gray-800">{paragraph}</p>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-background-2 border-b border-gray-200">
		<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<HeadingText
				heading="What I believe"
				subheading="Values"
				description="Every visit is guided by treating every person with respect, protecting their independence and, above all, taking the time to listen."
			/>

			<ul class="mt-10 flex flex-wrap items-center justify-center gap-4">
				{philosophy.values.map((value) => (
					<li class="rounded-full bg-brand-100 px-6 py-2.5 text-sm font-semibold text-brand-700 shadow-sm">
						{value}
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="bg-brand-600">
		<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-fraunces font-semibold tracking-tight text-white sm:text-4xl">
				I would love to meet you
			</h2>
			<p class="mt-4 text-lg text-brand-100">
				Whether you have a question about my services or would like to arrange a visit, I am here to help.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow-lg transition hover:bg-brand-50"
			>
				Get in touch
			</a>
		</div>
	</section>
</Layout>