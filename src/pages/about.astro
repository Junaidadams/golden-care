---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import HeadingText from '../components/HeadingText.astro';
import Icon from '../components/Icon.tsx';
import { about, philosophy } from '../../constants';
import herBanner from '../assets/her-banner-wr.jpg';
---

<Layout
	title="About"
	description="Meet the companion behind Within Reach — learn about the values, experience and approach behind my personalised companionship services."
>
	<PageHeader
		image={herBanner}
		title={`About Me`}
		subtitle="About"
		description="Growing older should not mean becoming less independent — meet the companion behind Within Reach."
	/>

	<section class="bg-background-1 border-b border-gray-200">
		<div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
				<div class="relative flex aspect-[4/5] items-center justify-center overflow-hidden rounded-sm bg-gradient-to-br from-brand-100 via-brand-50 to-gray-100 shadow-sm">
					<!-- TODO: replace placeholder with a photo of Caryl when available -->
					<Icon name="FaUserNurse" className="h-24 w-24 text-brand-600/40" />
					<span class="absolute bottom-4 rounded-lg bg-white/80 px-4 py-2 text-sm font-semibold text-gray-700 backdrop-blur">
						{about.name}
					</span>
				</div>

				<div>
					<HeadingText
						heading={about.name}
						subheading="About"
						description={about.paragraphs[0]}
						position="left"
					/>

					<blockquote class="mt-8 border-l-4 border-brand-600 pl-4 text-lg italic leading-relaxed text-gray-800">
						{about.paragraphs[1]}
					</blockquote>

					<div class="mt-8 space-y-5">
						<p class="leading-relaxed text-gray-800">{about.paragraphs[2]}</p>
						<p class="leading-relaxed text-gray-800">{about.paragraphs[3]}</p>
						<p class="leading-relaxed text-gray-800">{about.paragraphs[4]}</p>
						<p class="mt-2 font-fraunces text-xl font-semibold italic text-brand-700">
							{about.tagline}
						</p>
						<p class="leading-relaxed text-gray-800">{about.paragraphs[5]}</p>
						<p class="leading-relaxed text-gray-800">{about.paragraphs[6]}</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-background-2 border-b border-gray-200">
		<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<HeadingText
				heading="What I believe"
				subheading="Values"
				description="Every visit is guided by treating every person with respect, protecting their independence and, above all, taking the time to listen."
			/>

			<ul class="mt-10 flex flex-wrap items-center justify-center gap-4">
				{philosophy.values.map((value) => (
					<li class="rounded-full bg-brand-100 px-6 py-2.5 text-sm font-semibold text-brand-700 shadow-sm">
						{value}
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="bg-brand-600">
		<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-fraunces font-semibold tracking-tight text-white sm:text-4xl">
				I'd love to meet you
			</h2>
			<p class="mt-4 text-lg text-brand-100">
				Whether you have a question about my services or would like to arrange a visit, I'm here to help.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow-lg transition hover:bg-brand-50"
			>
				Get in touch
			</a>
		</div>
	</section>
</Layout>