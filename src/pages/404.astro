---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found"
	description="The page you are looking for could not be found. Let me bring you back to somewhere familiar."
>
	<section class="bg-background-1 border-b border-gray-200">
		<div class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-4 py-28 text-center sm:px-6 lg:px-8">
			<span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-500 font-fraunces text-2xl font-black text-white">
				404
			</span>
			<h1 class="mt-8 font-fraunces text-4xl font-extrabold tracking-wide text-gray-900 sm:text-6xl">
				This page is out of reach
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600">
				The address may have changed, or the page may have moved. Let me bring you back to
				somewhere familiar.
			</p>
			<div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
				<a
					href="/"
					class="rounded-lg bg-brand-600 px-8 py-3 text-base font-semibold text-white shadow-sm shadow-brand-600/30 transition hover:bg-brand-700"
				>
					Back to home
				</a>
				<a
					href="/contact"
					class="rounded-lg border border-brand-600 px-8 py-3 text-base font-semibold text-brand-700 transition hover:bg-brand-50"
				>
					Get in touch
				</a>
			</div>
		</div>
	</section>
</Layout>