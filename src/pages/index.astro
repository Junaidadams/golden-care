---

import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Packages from '../components/Packages.astro';
import Subscriptions from '../components/Subscriptions.astro';
import Location from '../components/Location.astro';
import Philosophy from '../components/Philosophy.astro';
import MiniFaq from '../components/MiniFaq.astro';
import heroBanner from '../assets/herobanner2.jpg';

const heroPreload = await getImage({
	src: heroBanner,
	width: 1600,
	quality: 'medium',
	format: 'avif',
});
---

<Layout
	title="Companionship & support for older adults in the Helderberg area"
	description="Friendly, personalised companionship for older adults in the Helderberg area — from a chat over tea to help with shopping, errands, admin and appointments."
>
	<link rel="preload" as="image" href={heroPreload.src} fetchpriority="high" slot="head" />
	<Hero />
	<Packages />
	<Subscriptions />
	<Location />
	<MiniFaq/>
	<Philosophy />
</Layout>
