---
import { features } from '../../constants';
import type { Feature } from '../../constants';
import Icon from './Icon.tsx';

interface Props {
	items: Feature[];
}

const { items = features } = Astro.props;
---

<section id="features" class="bg-background-2 border-b border-gray-200
">
	<div class="mx-auto max-w-5xl px-10 py-20">
		<div class=" grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{items.map((feature) => (
				<article class="flex items-center gap-4 transition hover:-translate-y-1">
					<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
						<Icon name={feature.icon} className="h-6 w-6" />
					</div>
					<div class="flex flex-col gap-1">
						<h3 class=" text-lg font-semibold text-gray-900">{feature.heading}</h3>
						<p class=" text-sm leading-relaxed text-gray-800">{feature.description}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
