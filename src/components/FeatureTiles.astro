---
import { features } from '../../constants';
import type { Feature } from '../../constants';
import Icon from './Icon.tsx';

interface Props {
	items: Feature[];
}

const { items = features } = Astro.props;
---

<section id="features" class="bg-white">
	<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
				Why choose Golden Care
			</h2>
			<p class="mt-4 text-lg text-gray-600">
				Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.
			</p>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{items.map((feature) => (
				<article class="rounded-2xl border border-gray-100 p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
						<Icon name={feature.icon} className="h-6 w-6" />
					</span>
					<h3 class="mt-5 text-lg font-semibold text-gray-900">{feature.heading}</h3>
					<p class="mt-3 text-sm leading-relaxed text-gray-600">{feature.description}</p>
				</article>
			))}
		</div>
	</div>
</section>
