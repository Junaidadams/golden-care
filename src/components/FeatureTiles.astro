---
import { features } from '../../constants';
import type { Feature } from '../../constants';
import Icon from './Icon.tsx';

interface Props {
	items: Feature[];
}

const { items = features } = Astro.props;
---

<section id="features" class="bg-white">
	<div class="mx-auto max-w-7xl p-10">
		<div class=" grid grid-cols-1 gap-1 sm:grid-cols-2 lg:grid-cols-4">
			{items.map((feature) => (
				<article class="flex items-center gap-2 transition hover:-translate-y-1">
					<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
						<Icon name={feature.icon} className="h-6 w-6" />
					</div>
					<div class="flex flex-col gap-2">
						<h3 class=" text-lg font-semibold text-gray-900">{feature.heading}</h3>
						<p class=" text-sm leading-relaxed text-gray-600">{feature.description}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
