---
import Icon from '../components/Icon.tsx';
import { faqs } from '../../constants';
import HeadingText from '../components/HeadingText.astro';
import { BiChevronRightCircle } from 'react-icons/bi';
import FaqTile from './FaqTile.astro';

---


	<section class="bg-background-2 border-b border-gray-200">
	<div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8 z-10 relative">
  		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
            <div>
				<HeadingText heading="Frequently Asked" subheading='location' description="We understand you may have many questions about Within Reach. Here are a few common inquiries." position="left" />

				<a class="text-brand-600 font-semibold text-lg inline-flex mt-6" href="/faq">View all FAQs <BiChevronRightCircle className='my-auto ml-3 ' /></a>
				<!-- <p>Note: if you area is not listed above, give us a call and we will try to find a solution</p> -->
			</div>
                <div class="mx-auto x-4 py-24 sm:px-6 lg:px-8">
                    <div class="space-y-4">
                        {faqs.slice(0, 3).map((faq) => (
                            <FaqTile faq={faq} isMini={true} Icon={Icon} />
                            // <details class="group overflow-hidden rounded-sm bg-white shadow-sm transition">
                            //     <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-fraunces text-sm font-semibold text-gray-900 [&::-webkit-details-marker]:hidden">
                            //         <span>{faq.question}</span>
                            //         <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600 transition duration-300 group-open:rotate-45">
                            //             <Icon name="FiPlus" className="h-5 w-5" />
                            //         </span>
                            //     </summary>
                            //     <p class="px-5 pb-5 text-base leading-relaxed text-gray-600">{faq.answer}</p>
                            // </details>
                        ))}
                    </div>
                </div>
            </div>
            
        </div>
	</section>
