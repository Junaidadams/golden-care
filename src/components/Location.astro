---
import { locations } from '../../constants';
import Icon from './Icon.tsx';
---

<section id="locations" class="bg-white">
	<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
			<div>
				<h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
					{locations.heading}
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-gray-600">{locations.text}</p>

				<ul class="mt-8 grid grid-cols-2 gap-4">
					{locations.areas.map((area) => (
						<li class="flex items-center gap-3 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700">
							<Icon name="FaMapMarkerAlt" className="h-4 w-4 text-brand-600" />
							{area}
						</li>
					))}
				</ul>
			</div>

			<div class="relative flex h-96 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-brand-100 via-brand-50 to-gray-100">
				<Icon name="FaMapMarkedAlt" className="h-32 w-32 text-brand-600/40" />
				<span class="absolute bottom-6 left-6 rounded-lg bg-white/80 px-4 py-2 text-sm font-semibold text-gray-700 backdrop-blur">
					Service area placeholder
				</span>
			</div>
		</div>
	</div>
</section>
