---
import { Image } from 'astro:assets';
import { locations } from '../../constants';
import HeadingText from './HeadingText.astro';
import Icon from './Icon.tsx';
import textureImage from '../assets/texture.png';
import mapImage from '../assets/map.png';
---

<section id="locations" class="bg-background-2 relative">
	<Image
		src={textureImage}
		alt=""
		widths={[600, 1000, 1600]}
		sizes="100vw"
		quality="medium"
		loading="lazy"
		class="w-full h-full object-cover z-0 absolute top-0 opacity-25"
	/>
	<div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8 z-10 relative">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
			<div>
				<HeadingText heading={locations.heading} subheading='location' description={locations.text} position="left" />

				<ul class="mt-8 grid grid-cols-2">
					{locations.areas.map((area) => (
						<li class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-gray-700">
							<Icon name="FaMapMarkerAlt" className="h-4 w-4 text-[#D6B17B]" />
							{area}
						</li>
					))}
				</ul>
				<!-- <p>Note: if you area is not listed above, give us a call and we will try to find a solution</p> -->
			</div>

			<div class="relative flex items-center justify-center overflow-hidden rounded-sm bg-gradient-to-br from-brand-100 via-brand-50 to-gray-100 shadow-xl">
				<!-- <Icon name="FaMapMarkedAlt" className="h-32 w-32 text-brand-600/40" />
				<span class="absolute bottom-6 left-6 rounded-lg bg-white/80 px-4 py-2 text-sm font-semibold text-gray-700 backdrop-blur">
					Service area placeholder
				</span> -->
				<div class="bg-[#f3efdb] p-1 rounded-sm">					
					<div class="bg-brand-600 p-1 rounded-sm">
						<Image
							src={mapImage}
							alt="Map of our service area"
							widths={[600, 900, 1280]}
							sizes="(min-width: 1024px) 50vw, 100vw"
							quality="medium"
							loading="lazy"
							class="w-full h-full rounded-sm"
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
