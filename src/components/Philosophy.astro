---
import { philosophy } from '../../constants';
---

<section id="philosophy" class="bg-brand-600">
	<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
		<span class="inline-block rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white">
			What we believe
		</span>
		<h2 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">
			{philosophy.heading}
		</h2>
		<p class="mt-6 text-lg leading-relaxed text-brand-100">{philosophy.text}</p>

		<ul class="mt-10 flex flex-wrap items-center justify-center gap-4">
			{philosophy.values.map((value) => (
				<li class="rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-brand-700">
					{value}
				</li>
			))}
		</ul>
	</div>
</section>
