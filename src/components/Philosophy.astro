---
import { philosophy } from '../../constants';
import HeadingText from './HeadingText.astro';
---

<section id="philosophy" class="bg-brand-600">
	<div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
		<HeadingText
			heading={philosophy.heading}
			subheading="What I believe"
			description={philosophy.text}
			colors="dark"
		/>

		<ul class="mt-10 flex flex-wrap items-center justify-center gap-4">
			{philosophy.values.map((value) => (
				<li class="rounded-full shadow-lg bg-white px-6 py-2.5 text-sm font-semibold text-brand-700">
					{value}
				</li>
			))}
		</ul>
	</div>
</section>
