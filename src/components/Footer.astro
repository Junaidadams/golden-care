---
import { siteName, footerColumns, footerContact, socialLinks } from '../../constants';
import Icon from './Icon.tsx';
import Logo from './Logo.astro';
---

<footer class="bg-background-2 text-gray-800">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-4">
			<div class="">
			<Logo/>
				<p class="mt-4 text-sm leading-relaxed text-gray-800">
					Friendly, personalised assistance in the Helderberg area — helping you stay
					independent and enjoy life at home.
				</p>
				<ul class="mt-6 flex gap-4">
					{socialLinks.map((social) => (
						<li>
							<a
								href={social.href}
								aria-label={social.label}
								class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-white transition "
							>
								<Icon name={social.icon} className="h-4 w-4" />
							</a>
						</li>
					))}
				</ul>
			</div>

			{footerColumns.map((column) => (
				<div class="mx-auto">
					<h3 class="text-sm font-semibold uppercase tracking-wider text-black">
						{column.heading}
					</h3>
					<ul class="mt-4 space-y-3">
						{column.links.map((link) => (
							<li>
								<a href={link.href} class="text-sm text-gray-800 transition ">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}

			<div class="mx-auto">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-black">Contact</h3>
				<ul class="mt-4 space-y-3 text-sm text-gray-800">
					<li>
						<a
							href={`tel:${footerContact.phone.replace(/\s/g, '')}`}
							class="flex items-center gap-2 transition "
						>
							<Icon name="FaPhoneAlt" className="h-4 w-4 text-brand-500" />
							{footerContact.phone}
						</a>
					</li>
					<li>
						<a
							href={`mailto:${footerContact.email}`}
							class="flex items-center gap-2 transition "
						>
							<Icon name="FaEnvelope" className="h-4 w-4 text-brand-500" />
							{footerContact.email}
						</a>
					</li>
					<li class="flex items-start gap-2">
						<Icon name="FaMapMarkerAlt" className="mt-1 h-4 w-4 shrink-0 text-brand-500" />
						{footerContact.address}
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 border-t border-gray-500 pt-8 text-center text-sm text-gray-800">
			&copy; {new Date().getFullYear()} {siteName}. All rights reserved.
		</div>
	</div>
</footer>
