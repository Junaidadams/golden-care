---
interface Props {
	title: string;
	subtitle?: string;
	description?: string;
	image?: string;
}

const { title, subtitle, description, image } = Astro.props;
---

<section class="relative overflow-hidden">
	<img src={image} class="absolute inset-0 z-0 h-full w-full object-cover brightness-50" />
	<div class="relative z-10 mx-auto max-w-4xl px-4 py-28 text-center text-white sm:px-6 lg:px-8">
		{subtitle && (
			<span class="inline-block rounded-full bg-brand-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
				{subtitle}
			</span>
		)}
		<h1 class="mt-6 text-4xl font-fraunces font-extrabold tracking-wide sm:text-5xl">{title}</h1>
		{description && <p class="mt-6 text-lg font-semibold leading-relaxed text-white/90">{description}</p>}
	</div>
</section>
