---
interface Props {
	heading: string;
	subheading?: string;
	description?: string;
	position?: 'center' | 'left';
	colors?: 'light' | 'dark';
}

const { heading, subheading, description, position = 'center', colors = 'light' } = Astro.props;

const wrapperClass = position === 'left' ? 'max-w-2xl' : 'mx-auto max-w-2xl text-center';
const pillClass =
	colors === 'dark'
		? 'bg-white/15 text-white'
		: 'bg-brand-100 text-brand-700';
const headingClass =
	colors === 'dark' ? 'text-white' : 'text-gray-900';
const descriptionClass =
	colors === 'dark' ? 'text-brand-100' : 'text-gray-600';
---

<div class={wrapperClass}>
	{subheading && (
		<span class={`inline-block rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-wider ${pillClass}`}>
			{subheading}
		</span>
	)}
	<h2 class={`mt-2 text-3xl tracking-tight sm:text-4xl font-fraunces font-semibold ${headingClass}`}>
		{heading}
	</h2>
	{description && <p class={`mt-4 text-lg ${descriptionClass}`}>{description}</p>}
</div>
