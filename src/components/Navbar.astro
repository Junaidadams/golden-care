---
import { navLinks, siteName } from '../../constants';
import MobileMenu from './MobileMenu.tsx';
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white">
	<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-2 text-xl font-bold text-brand-600">
			<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 font-black text-white">
				GC
			</span>
			{siteName}
		</a>

		<ul class="hidden items-center gap-8 md:flex">
			{navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="text-sm font-medium text-gray-700 transition hover:text-brand-600"
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		<a
			href="#packages"
			class="hidden rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700 md:block"
		>
			Book a visit
		</a>

		<MobileMenu client:load navLinks={navLinks} />
	</nav>
</header>
