---
import { navLinks, siteName } from '../../constants';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.tsx';
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-background-2">
	<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
	<Logo/>

		<ul class="hidden items-center gap-8 md:flex">
			{navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="text-sm font-medium text-gray-700 transition hover:text-brand-600"
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>



		<MobileMenu client:load navLinks={navLinks} />
	</nav>
</header>
