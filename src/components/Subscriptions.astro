---
import { subscriptions } from '../../constants';
import type { Subscription } from '../../constants';
import HeadingText from './HeadingText.astro';
import Icon from './Icon.tsx';

interface Props {
	items: Subscription[];
}

const { items = subscriptions } = Astro.props;
---

<section id="subscriptions" class="bg-background-2 border-b border-gray-200">
	<div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8">
		<HeadingText
			heading="Monthly Subscriptions"
			subheading="Plans"
			description="Regular visits at a predictable monthly rate — great for ongoing support and assistance."
		/>

		<div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
			{items.map((plan) => (
				<article class="flex flex-col overflow-hidden rounded-sm bg-background-2 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<div class="flex flex-1 flex-col p-4">
						<h3 class="text-xl font-bold text-black">{plan.name}</h3>
						<p class="mt-1 text-sm font-semibold text-brand-700">
							{plan.price}
							<span class="text-xs font-medium text-gray-500"> {plan.cadence}</span>
						</p>
						<ul class="mt-4 flex-1 space-y-3">
							{plan.points.map((point) => (
								<li class="flex items-start gap-3 text-sm text-gray-800">
									<Icon name="FiCheckCircle" className="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />
									{point}
								</li>
							))}
						</ul>
						<a
							href={plan.cta.href}
							class="mt-8 rounded-2xl bg-brand-600 px-6 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-700"
						>
							{plan.cta.label}
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>