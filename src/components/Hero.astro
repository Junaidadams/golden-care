---
import { Image } from 'astro:assets';
import { hero } from '../../constants';
import heroBanner from '../assets/hero-banner.jpeg';
import heroBannerMb from '../assets/hero-banner-mb.jpeg';
---

<section class="section-size relative overflow-hidden">
	<Image
		src={heroBanner}
		alt=""
		widths={[800, 1200, 1600, 1920]}
		sizes="100vw"
		quality="medium"
		loading="eager"
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 z-0 hidden h-full w-full object-cover object-center brightness-75 md:block"
	/>
	<Image
		src={heroBannerMb}
		alt=""
		widths={[320, 465]}
		sizes="100vw"
		quality="medium"
		loading="eager"
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 z-0 h-full w-full object-cover object-center brightness-75 md:hidden"
	/>
	<div class="absolute inset-0 z-10 mx-auto flex max-w-7xl items-center px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl  text-white text-left">
			<h1 class="mt-6 text-4xl font-fraunces tracking-wide font-extrabold sm:text-5xl lg:text-5xl">
				{hero.heading}
			</h1>
			<p class="mt-6 text-lg leading-normal font-semibold ">{hero.text}</p>
			<div class="mt-10 flex flex-col items-start gap-4 sm:flex-row border-gray-300 border-b pb-10">
				{hero.ctas.map((cta) =>
					cta.primary ? (
						<a
							href={cta.href}
							class="rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-900 shadow-lg shadow-brand-600/30 transition hover:bg-brand-100"
						>
							{cta.label}
						</a>
					) : (
						<a
							href={cta.href}
							class="rounded-lg border-2 border-white px-8 py-3 text-base font-semibold text-white transition hover:bg-brand-50"
						>
							{cta.label}
						</a>
					)
				)}
			</div>
			<div></div>
		</div>
	</div>
</section>
