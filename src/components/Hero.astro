---
import { hero } from '../../constants';
---

<section class="bg-gradient-to-b from-brand-50 to-white">
	<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<span class="inline-block rounded-full bg-brand-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
				Care you can trust
			</span>
			<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
				{hero.heading}
			</h1>
			<p class="mt-6 text-lg leading-relaxed text-gray-600">{hero.text}</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				{hero.ctas.map((cta) =>
					cta.primary ? (
						<a
							href={cta.href}
							class="rounded-lg bg-brand-600 px-8 py-3 text-base font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:bg-brand-700"
						>
							{cta.label}
						</a>
					) : (
						<a
							href={cta.href}
							class="rounded-lg border-2 border-brand-600 px-8 py-3 text-base font-semibold text-brand-600 transition hover:bg-brand-50"
						>
							{cta.label}
						</a>
					),
				)}
			</div>
		</div>
	</div>
</section>
