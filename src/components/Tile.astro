---
import Icon from './Icon.tsx';
import type { IconName } from '../constants';

interface Props {
	heading: string;
	icon: IconName;
}

const { heading, icon } = Astro.props;
---

<div class="rounded-sm bg-white p-8 shadow-sm">
	<h2 class="flex items-center gap-3 text-xl font-bold text-gray-900">
		<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
			<Icon name={icon} className="h-5 w-5" />
		</span>
		{heading}
	</h2>
	<slot />
</div>
